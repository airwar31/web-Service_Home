# ===================================================================
# Smart Home Web Service - Environment Configuration Template
# Copy this file to .env and adjust variables:
#   cp .env.example .env
# ===================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False
USE_SSL=False

# SSL Configuration (Optional: self-signed certs or leave empty for adhoc/http)
# SSL_CERT_PATH=cert.pem
# SSL_KEY_PATH=key.pem

# Database Path (defaults to backend/devices.sqlite3)
DATABASE_PATH=backend/devices.sqlite3

# OpenAI API Key (Optional: for advanced voice/intent interpretation)
OPENAI_API_KEY=your_openai_api_key_here

# Home Assistant Integration (Optional)
# HA_URL should include protocol and port, e.g. http://192.168.1.10:8123
HA_URL=
# Home Assistant Long-Lived Access Token
HA_TOKEN=

# MQTT Broker (Optional: for Home Assistant event publishing)
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC=homeassistant/voice/commands

# Whisper Speech Recognition Model (tiny, base, small, medium)
WHISPER_MODEL=tiny

# Optional: Path to ffmpeg binary if not in system PATH
# FFMPEG_PATH=ffmpeg
