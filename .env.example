# Example environment variables for Home Assistant integration
# Copy this file to .env and fill values locally (do NOT commit .env to git)

# Home Assistant REST API (optional)
# HA_URL should include protocol and port, e.g. http://192.168.1.10:8123
HA_URL=
# Long-Lived Access Token (create in your Home Assistant profile)
HA_TOKEN=

# MQTT broker (optional). If set, the bridge will publish intents to MQTT_TOPIC.
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC=homeassistant/voice/commands

# Optional: path to ffmpeg if not in PATH
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
